# Copia este archivo como .env únicamente en el servidor. No subas .env a Git.
# POSTGRES_PASSWORD y DATABASE_URL deben usar la misma contraseña.
POSTGRES_PASSWORD=CAMBIA_ESTO_POR_UN_SECRETO_LARGO_Y_UNICO
DATABASE_URL=postgresql+psycopg://alejandra:CAMBIA_ESTO_POR_UN_SECRETO_LARGO_Y_UNICO@db:5432/alejandra
FRONTEND_ORIGINS=https://tudominio.es

# Se usan solo al crear una base de datos nueva y la primera administradora.
ADMIN_EMAIL=admin@tudominio.es
ADMIN_PASSWORD=CAMBIA_ESTO_POR_UNA_CONTRASENA_LARGA_Y_UNICA
